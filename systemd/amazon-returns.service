[Unit]
Description=Amazon Returns Checker
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/amazon-returns
ExecStart=/home/CHANGE_ME/amazon-returns/venv/bin/python /home/CHANGE_ME/amazon-returns/scripts/amazon_returns.py
# Exit code 2 = Amazon login expired. The unit shows as failed and
# returns.json gets status "login_required", so Home Assistant can alert you.
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600
